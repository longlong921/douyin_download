cabal-version: 2.4
name: douyin-download
version: 2.0.0
build-type: Simple
common shared
  default-language: Haskell2010
  ghc-options: -Wall -threaded -rtsopts
  hs-source-dirs: src
  build-depends: base >=4.16 && <5, aeson, bytestring, text, containers, time, stm, network, connection, network-uri, http-client, http-client-tls, http-types, wai, warp, lucid, cryptonite, memory, attoparsec, directory
executable douyin-download
  import: shared
  main-is: Main.hs
  other-modules: Types, Network, Parser, View, App
executable security-tests
  import: shared
  hs-source-dirs: test
  main-is: Spec.hs
  other-modules: Types, Network, Parser, View, App
