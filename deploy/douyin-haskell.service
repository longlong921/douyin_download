[Unit]
Description=Shiying Douyin downloader (Haskell)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/douyin-haskell/current
ExecStart=/opt/douyin-haskell/current/douyin-download +RTS -N1 -M192m -RTS
Environment=PORT=8187
Environment=BIND_ADDRESS=127.0.0.1
Environment=BASE_PATH=/douyin
Environment=STATIC_DIR=/opt/douyin-haskell/current/static
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
MemoryMax=256M
CPUQuota=50%
TasksMax=64
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
